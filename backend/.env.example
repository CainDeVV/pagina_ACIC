# =========================================================================
# backend/.env.example — Backend NestJS do Portal ACIC Crateús
# =========================================================================
# Copie para backend/.env e preencha os valores reais.
# Usado quando o backend roda FORA do Docker (ex: npm run start:dev).
# Para Docker, as variáveis são injetadas pelo docker-compose.yml a partir do .env raiz.
# O .env NUNCA deve ser comitado no git.
# =========================================================================

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/acic_db"

# Segredo JWT — deve ser IGUAL ao JWT_SECRET do .env raiz
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="troque_por_um_valor_aleatorio_e_longo"

# Porta do servidor
PORT=3000
