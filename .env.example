# =========================================================================
# .env.example — Portal ACIC Crateús
# =========================================================================
# Copie este arquivo para .env e preencha os valores reais.
# O .env NUNCA deve ser comitado no git (já está no .gitignore).
# =========================================================================

# 1. Configurações do Banco de Dados (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_DB=acic_db
POSTGRES_PORT=5432

# 2. Configurações de Segurança do Backend
# Gere um valor forte com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=troque_por_um_valor_aleatorio_e_longo
NODE_ENV=development
