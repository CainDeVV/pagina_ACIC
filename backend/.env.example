# Exemplo de configuração de variáveis de ambiente para o Backend
# Copie este arquivo para .env e preencha com seus dados reais

# Conexão com o banco de dados (Prisma/PostgreSQL)
# Estrutura: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acic_db?schema=public"

# Chave secreta usada para assinar os tokens JWT (Use uma string longa e aleatória em produção)
JWT_SECRET="insira_sua_chave_secreta_aqui_para_assinatura_de_tokens"

# Opcional: Variáveis para controle de ambiente
# NODE_ENV="development"
