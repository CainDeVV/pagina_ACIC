# =========================================================================
# Configurações de Exemplo - Portal ACIC Crateús
# =========================================================================
# Copie este arquivo para .env e preencha com seus dados.
# =========================================================================

# 1. Configurações do Banco de Dados (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=acic_db
POSTGRES_PORT=5432

# 2. Configurações de Segurança e Ambiente do Backend
# Usado pelo docker-compose.yml para injetar JWT_SECRET no container do backend
JWT_SECRET=gere_uma_chave_secreta_forte_aqui
NODE_ENV=development

# 3. Configurações de Email (SMTP Gmail) — 2FA por OTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seu_email@exemplo.com
MAIL_PASS=sua_senha_de_app_aqui
MAIL_FROM="Portal ACIC <seu_email@exemplo.com>"
